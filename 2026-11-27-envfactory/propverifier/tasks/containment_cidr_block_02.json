  "reference_fix": "0 <= net.prefix_len <= 32 and (addr.value & mask_bits(net.prefix_len)) == (net.base & mask_bits(net.prefix_len))",
  "alternate_fixes": [
    "0 <= net.prefix_len < 33 and (net.base & mask_bits(net.prefix_len)) == (addr.value & mask_bits(net.prefix_len))",
    "net.prefix_len <= 32 and net.prefix_len >= 0 and mask_bits(net.prefix_len) & net.base == mask_bits(net.prefix_len) & addr.value",
    "0 <= net.prefix_len <= 32 and 0 == ((addr.value ^ net.base) & mask_bits(net.prefix_len))"
