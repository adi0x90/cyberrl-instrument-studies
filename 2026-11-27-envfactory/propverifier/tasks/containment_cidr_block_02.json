{
  "id": "containment_cidr_block_02",
  "family": "containment",
  "polarity_sensitive": true,
  "source": "\"\"\"Egress containment against a classless allowlist.\"\"\"\n\n\ndef parse_ip(dotted):\n    a, b, c, d = (int(part) for part in dotted.split(\".\"))\n    return (a << 24) | (b << 16) | (c << 8) | d\n\n\ndef mask_bits(prefix_len):\n    return (0xFFFFFFFF << (32 - prefix_len)) & 0xFFFFFFFF\n\n\nclass Network:\n    def __init__(self, base, prefix_len):\n        self.base = base\n        self.prefix_len = prefix_len\n\n\nclass Address:\n    def __init__(self, value):\n        self.value = value\n\n\ndef contained(net, addr):\n    return REPLACE_ME\n",
  "editable": {
    "path": "def contained",
    "mode": "expression"
  },
  "placeholder": "REPLACE_ME",
  "property": "An address is contained in a network only when the prefix length is a valid IPv4 length and the address masked by that prefix equals the masked network base.",
  "security_cases": [
    {
      "id": "s1_outside_prefix",
      "call": "contained(Network(parse_ip(\"10.0.0.0\"), 8), Address(parse_ip(\"192.168.1.5\")))",
      "expect_error": false,
      "expect": false
    },
    {
      "id": "s2_neighbour_prefix",
